---
import '../../styles/global.css';
import { supabaseConfig } from '../../lib/content';

const repo = import.meta.env.PUBLIC_GITHUB_REPO ?? '';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Site admin</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div id="app" data-url={supabaseConfig.url} data-key={supabaseConfig.key} data-repo={repo}>
      <p class="wrap muted" style="padding-top:2rem">Loading the admin panel…</p>
    </div>
    <script>
      import '../../admin/app.ts';
    </script>
  </body>
</html>
