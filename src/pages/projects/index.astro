---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getContent, projectCategories } from '../../lib/content';

const { projects } = await getContent();
const categories = projectCategories(projects);
---

<Base title="Projects" description="Security labs, web systems, games, 3D work, e-commerce and research projects.">
  <header class="page-head wrap">
    <h1>Projects</h1>
    <p>Security testing, web systems, games, 3D and video work, e-commerce and research.</p>
  </header>

  <section class="wrap">
    {categories.length > 1 && (
      <div class="filters" role="group" aria-label="Filter projects" id="filters" hidden>
        <button type="button" data-filter="" aria-pressed="true">All</button>
        {categories.map((c) => (
          <button type="button" data-filter={c} aria-pressed="false">{c}</button>
        ))}
      </div>
    )}
    {projects.length ? (
      <div class="project-grid" id="project-grid">
        {projects.map((p, i) => <ProjectCard project={p} eager={i < 2} />)}
      </div>
    ) : (
      <p class="muted">No projects are published yet.</p>
    )}
    <p class="muted" id="filter-empty" hidden>No projects in this category yet.</p>
  </section>
</Base>

<script is:inline>
  (() => {
    const bar = document.getElementById('filters');
    if (!bar) return;
    bar.hidden = false;
    const cards = [...document.querySelectorAll('#project-grid .project-card')];
    const empty = document.getElementById('filter-empty');
    const apply = (cat, push) => {
      let shown = 0;
      for (const card of cards) {
        const match = !cat || card.dataset.category === cat;
        card.hidden = !match;
        if (match) shown++;
      }
      for (const b of bar.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b.dataset.filter === cat));
      empty.hidden = shown > 0;
      if (push) {
        const url = new URL(location.href);
        cat ? url.searchParams.set('c', cat) : url.searchParams.delete('c');
        history.replaceState(null, '', url);
      }
    };
    bar.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (b) apply(b.dataset.filter, true);
    });
    const initial = new URL(location.href).searchParams.get('c') || '';
    const known = [...bar.querySelectorAll('button')].some((b) => b.dataset.filter === initial);
    apply(known ? initial : '', false);
  })();
</script>
